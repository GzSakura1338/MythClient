<Window
    x:Class="NovaInjector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NovaInjector"
    Title="Nova Injector">
    <Grid x:ConnectionId='2' x:Name="RootGrid" RequestedTheme="Default" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:ConnectionId='3' x:Name="AppTitleBar" Height="48" Padding="20,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:ConnectionId='39' x:Name="CaptionInset" Width="138" />
            </Grid.ColumnDefinitions>
            <TextBlock x:ConnectionId='40' x:Name="TitleBarText" Text="Nova Injector" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch">
            <Grid x:ConnectionId='7' x:Name="MainContent" Padding="20,12,20,20" MaxWidth="860" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <Border HorizontalAlignment="Center" Width="320" Padding="4" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ToggleButton x:ConnectionId='37' x:Name="MinecraftTab" Content="Minecraft" MinHeight="36"
                                          HorizontalAlignment="Stretch" CornerRadius="7"                      
                                          AutomationProperties.AutomationId="MinecraftTab" />
                            <ToggleButton x:ConnectionId='38' x:Name="Cs2Tab" Grid.Column="1" Content="CS2" MinHeight="36"
                                          HorizontalAlignment="Stretch" CornerRadius="7"                      
                                          AutomationProperties.AutomationId="Cs2Tab" />
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="16">
                            <StackPanel x:ConnectionId='14' x:Name="ProcessPanel" Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="目标进程" FontWeight="SemiBold" />
                                    <TextBlock x:ConnectionId='36' x:Name="ProcessHint" Grid.Column="1" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <ComboBox x:ConnectionId='28' x:Name="ProcessBox" PlaceholderText="选择 Java 进程" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch" MinWidth="0" MinHeight="56"
                                              AutomationProperties.Name="目标 Java 进程" AutomationProperties.AutomationId="ProcessBox">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate                               >
                                                <Grid x:ConnectionId='31' ColumnSpacing="10" Padding="0,2"                                          >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                        <Image x:ConnectionId='34'                                                             Stretch="Uniform" />
                                                        <FontIcon x:ConnectionId='35' Glyph="&#xE737;" FontSize="22"                                             
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock x:ConnectionId='32'                             FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:ConnectionId='33'                         Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:ConnectionId='29' x:Name="RefreshButton" Grid.Column="1" Content="刷新"                               
                                            MinWidth="80" VerticalAlignment="Center" AutomationProperties.Name="刷新 Java 进程" />
                                </Grid>
                            </StackPanel>
                            <StackPanel x:ConnectionId='15' x:Name="ClientVersionPanel" Spacing="8">
                                <TextBlock Text="客户端版本" FontWeight="SemiBold" />
                                <ComboBox x:ConnectionId='27' x:Name="ClientVersionBox" HorizontalAlignment="Stretch"
                                                                                           
                                          PlaceholderText="选择客户端版本" AutomationProperties.Name="客户端版本" AutomationProperties.AutomationId="ClientVersionBox" />
                            </StackPanel>
                            <TextBlock x:ConnectionId='16' x:Name="Cs2Notice" Text="支持 DirectX 11；Insert 打开界面，Delete 卸载。" Visibility="Collapsed"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:ConnectionId='17' x:Name="HeyPixelOptions" Spacing="8" Visibility="Collapsed">
                                <ToggleSwitch x:ConnectionId='20' x:Name="HeyPixelToggle" Header="HeyPixel 模式" OffContent="关闭" OnContent="开启"
                                                                         AutomationProperties.Name="HeyPixel 模式" AutomationProperties.AutomationId="HeyPixelToggle" />
                                <StackPanel x:ConnectionId='21' x:Name="HeyPixelDirectoryPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="通过 Java 的 winmm 代理在启动时加载 Nova，游戏接口就绪后初始化，无需进入服务器。请先退出游戏；已有代理会备份，旧 JAR 补丁会恢复。"
                                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:ConnectionId='22' x:Name="HeyPixelDirectoryBox" Header="网易游戏目录" AutomationProperties.AutomationId="HeyPixelDirectoryBox"
                                             PlaceholderText="自动识别 .minecraft 目录，也可手动选择" />
                                    <TextBox x:ConnectionId='23' x:Name="HeyPixelJavaBox" Header="网易 Java bin 目录" AutomationProperties.AutomationId="HeyPixelJavaBox"
                                             PlaceholderText="留空时自动识别；自定义 Java 可填写含 java.exe 的 bin 目录" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:ConnectionId='24' x:Name="DetectHeyPixelButton" Content="自动识别"                              />
                                        <Button x:ConnectionId='25' x:Name="PickGameDirectoryButton" Content="选择目录"                                 />
                                        <Button x:ConnectionId='26' x:Name="RestoreHeyPixelButton" Content="恢复原版"                               />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="注入 DLL" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox x:ConnectionId='18' x:Name="DllPathBox" PlaceholderText="选择 DLL 文件" IsReadOnly="True"
                                             AutomationProperties.Name="注入 DLL 路径" ToolTipService.ToolTip="{Binding Text, ElementName=DllPathBox}" />
                                    <Button x:ConnectionId='19' x:Name="PickDllButton" Grid.Column="1" Content="浏览…" MinWidth="80"
                                                                  AutomationProperties.Name="浏览并选择 DLL 文件" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid ColumnSpacing="10" MinHeight="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <InfoBar x:ConnectionId='10' x:Name="StatusBar" IsOpen="False" IsClosable="True" MinWidth="0"
                                 VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <Button x:ConnectionId='11' x:Name="PatchButton" Grid.Column="1"                     HorizontalAlignment="Right"
                                VerticalAlignment="Center" MinWidth="132" MinHeight="40"
                                Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="注入" AutomationProperties.AutomationId="PatchButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing x:ConnectionId='12' x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="16" Height="16" MinWidth="0" MinHeight="0"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock x:ConnectionId='13' x:Name="PatchButtonText" Text="注入" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Expander x:ConnectionId='8' x:Name="LogExpander" Header="运行日志" IsExpanded="True"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBox x:ConnectionId='9' x:Name="OutputBox" MinHeight="120" MaxHeight="200" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" FontSize="13" AutomationProperties.Name="运行日志" />
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <!-- Resolve theme brushes for the native caption buttons and fallback background. -->
        <Border x:ConnectionId='4' x:Name="CaptionPalette" Visibility="Collapsed" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource SubtleFillColorTertiaryBrush}" />
        <Border x:ConnectionId='5' x:Name="FallbackPalette" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <TextBlock x:ConnectionId='6' x:Name="InactiveCaptionPalette" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>

