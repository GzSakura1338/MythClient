# Build output. Note that the root `build/` is the injector's WinUI output, not
# the client's -- the client builds into Client/build-vs2026/.
build/
build-*/
out/
.vs/
*.user

# Compiler and linker artefacts that escape a build directory
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe

# Reference sources from other projects. Third-party code, and 112 MB of it.
skid/

# SRG dumps and scratch space
.tmp_mcp/

*.log

# Python validation caches are generated, not source.
__pycache__/

# Downloaded browser SDK/runtime archives; acquisition is pinned in chrome/tools.
Client/src/chrome/vendor/
Client/test/chrome/fixtures/
Client/test/chrome/packaging/obj/
Client/test/chrome/packaging/bin/

# Standalone injector integration-test output.
injector/tests/bin/
injector/tests/obj/
